# Systemd USER unit for the XREAL-flavor Monado runtime (WP-XR1), à la wivrn.service but wholly
# independent of it — no ordering against, and no Conflicts with, wivrn.service, so the two runtimes
# never fight (they use different IPC socket names; see docs/openxr/research/XREAL-3DOF.md §5).
#
# Install (one-time):
#   mkdir -p ~/.config/systemd/user
#   install -m 0644 contrib/xreal/monado-xreal.service ~/.config/systemd/user/monado-xreal.service
#   # Point it at YOUR xreal monado build (machine-agnostic override; skip if the default path is right):
#   mkdir -p ~/.config/xreal
#   echo 'MONADO_XREAL_SERVICE=/ABS/PATH/TO/subprojects/monado/build-xreal/src/xrt/targets/service/monado-service' > ~/.config/xreal/monado.env
#   systemctl --user daemon-reload
# scripts/xreal-mode.sh start/stops this unit; you normally do not start it by hand.

[Unit]
Description=Monado (XREAL Air flavor) OpenXR runtime for HypXRland
Documentation=https://github.com/hyprwm/Hyprland docs/openxr/07-xreal.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Default path assumes the repo at ~/code/Hyprland and the xreal build at subprojects/monado/build-xreal
# (scripts/build-monado.sh --xreal). Override MONADO_XREAL_SERVICE in ~/.config/xreal/monado.env for a
# different repo location (e.g. the Lunar Lake laptop) — the EnvironmentFile line below picks it up.
Environment=MONADO_XREAL_SERVICE=%h/code/Hyprland/subprojects/monado/build-xreal/src/xrt/targets/service/monado-service
# Force comp_main's Wayland window backend so the compositor output is an ordinary Wayland toplevel
# (app-id "openxr") that HypXRland fullscreens on the glasses' DisplayPort output. This is the DEFAULT
# (window) mode. `scripts/xreal-mode.sh xr --direct` drops in monado-xreal.service.d/10-xreal-direct.conf
# that overrides this (unsets it + sets XRT_COMPOSITOR_FORCE_WAYLAND_DIRECT=1 +
# XRT_COMPOSITOR_WAYLAND_CONNECTOR=<connector>) to select the direct-wayland (DRM-lease) backend;
# `flat`/window mode removes that drop-in. See docs/openxr/07-xreal.md.
Environment=XRT_COMPOSITOR_FORCE_WAYLAND=1
Environment=XRT_NO_STDIN=1
EnvironmentFile=-%h/.config/xreal/monado.env
ExecStart=/bin/sh -c 'exec "$MONADO_XREAL_SERVICE"'
Restart=no
# Clean shutdown: monado-service's IPC mainloop (ipc_server_mainloop_linux.c) only tears down on stdin
# activity/EOF (epoll on fd 0) — and we run it with XRT_NO_STDIN=1 (so a systemd /dev/null stdin does not
# EOF-shutdown it the instant it starts), which removes fd 0 from the epoll set entirely. The net effect is
# that this build has NO signal-driven shutdown path: SIGTERM and SIGINT are both effectively ignored, so a
# default `stop` hung for systemd's 90s TimeoutStopSec before SIGKILL. Since the service is stateless (it
# re-reads the device and recreates its IPC socket on every start) and the kernel releases the hidraw fds +
# Vulkan/Wayland resources on process death, we stop it decisively and immediately with SIGKILL — that
# makes stop/restart instant and, because the process dies from the configured stop signal, systemd records
# it as a clean stop (not a 'failed'/'timeout' unit). TimeoutStopSec is just a backstop.
# (Upstream-correct fix, out of scope here: patch monado to handle SIGINT/SIGTERM, or feed it a controllable
#  stdin — then this could be a graceful SIGTERM.)
KillSignal=SIGKILL
KillMode=mixed
TimeoutStopSec=10
# The main process necessarily dies FROM that SIGKILL, which systemd would otherwise record as
# Result=signal → a 'failed' unit; whitelist it so a normal stop leaves the unit cleanly inactive/dead.
SuccessExitStatus=SIGKILL
# monado-service needs WAYLAND_DISPLAY + XDG_RUNTIME_DIR to reach Hyprland; scripts/xreal-mode.sh runs
# `systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR` before starting this unit.

[Install]
WantedBy=graphical-session.target
